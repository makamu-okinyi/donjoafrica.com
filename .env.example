# Donjo landing site — environment variables
# Copy this file to ".env" and fill in real values from your Convex deployment.
# Vite inlines VITE_* at build time, so any change requires a rebuild/redeploy.

VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Public URL of the product app (login link). Defaults to https://hr.donjoafrica.com
VITE_APP_URL=

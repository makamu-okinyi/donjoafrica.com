# Donjo landing site — environment variables
# Copy this file to ".env" and fill in real values from your Supabase project.
# These are PUBLISHABLE (anon) values, safe to expose in the browser, but the
# real .env must stay git-ignored. Vite inlines VITE_* at build time, so any
# change requires a rebuild/redeploy.

VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-supabase-anon-key>"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"
